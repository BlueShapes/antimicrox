#include <windows.h>
#include "config.h"

IDI_ICON1 ICON DISCARDABLE "images/antimicrox.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION PROJECT_MAJOR_VERSION,PROJECT_MINOR_VERSION,PROJECT_PATCH_VERSION,0
 PRODUCTVERSION PROJECT_MAJOR_VERSION,PROJECT_MINOR_VERSION,PROJECT_PATCH_VERSION,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "BlueShapes contributors\0"
            VALUE "FileDescription", "AntiMicroX-Delta gamepad mapper\0"
            VALUE "FileVersion", PROJECT_VERSION_STRING "\0"
            VALUE "InternalName", "antimicrox-delta\0"
            VALUE "LegalCopyright", "Copyright (C) AntiMicroX and AntiMicroX-Delta contributors\0"
            VALUE "OriginalFilename", "antimicrox-delta.exe\0"
            VALUE "ProductName", "AntiMicroX-Delta\0"
            VALUE "ProductVersion", PROJECT_VERSION_STRING "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
