  <releases>
    <release version="1.0.0" date="2026-09-09" type="stable">
      <description><p>First independently versioned AntiMicroX-Delta release, based on AntiMicroX 3.6.1.</p></description>
    </release>
  </releases>
  <url type="homepage">https://github.com/BlueShapes/antimicrox/</url>
  <url type="bugtracker">https://github.com/BlueShapes/antimicrox/issues</url>
